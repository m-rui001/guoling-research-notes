    ([Christoffel 函数], [$lambda^i_n$（求积权）], [$K_Lambda$（点列加权）], [（隐式，经 $P$）], [$kappa$ 或其倒数]),
    ([采样测度], [$nu_(bold(n))$（Gauss 网格）], [确定性点集], [Chebyshev 偏置], [平衡测度 / induced $mu$]),
    ([预条件], [$sqrt(n lambda_n)$], [$1\/sqrt(K_Lambda)$ 进基], [$bold(W)$ 行 + $bold(P)$ 列], [$w_m = K(z_m)$ 或 $1\/kappa$]),
    ([优化问题], [加权基追踪], [加权最小二乘], [梯度增强基追踪], [加权 LS / 加权基追踪]),
