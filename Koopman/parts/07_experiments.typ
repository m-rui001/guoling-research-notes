  columns: (auto, auto, auto, auto, auto),
  inset: 6pt,
  align: (left, center, center, center, center),
  stroke: 0.4pt + luma(190),
  table.header([*任务*], [*E2C*], [*PCC*], [*KAE*], [*本文*]),
  [Planar], [37.8], [71.4], [12.2], [*73.8*],
  [Pendulum], [88.5], [90.1], [68.2], [*91.5*],
  [Cartpole], [39.5], [94.1], [*98.5*], [97.6],
